<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows-SDK-TFM (statt net9.0-windows): schaltet die WinRT-Projektionen frei, u.a.
         Windows.Graphics.Capture (WGC) für die Fenster-/Vollbild-App-Aufnahme. WinForms bleibt.
         API-Surface 22621 (damit IsBorderRequired bekannt ist), aber Runtime-Floor 19041 → die App
         läuft weiter auf Windows 10 (2004+, das WGC-Minimum); neuere APIs werden zur Laufzeit
         versionsgeguarded (OperatingSystem.IsWindowsVersionAtLeast). -->
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>RitschyMirror</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Version>1.3.2</Version>
    <Product>RitschyMirror</Product>
    <Company>RitschyRigz</Company>
    <Description>Screen Mirror Tool for capture cards (HDR-to-SDR tonemapping)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
  </ItemGroup>

  <ItemGroup>
    <None Update="mirror_config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Icons fuer Tray + Fenster (LogicalName fest, damit AppIcon.Load sie findet).
         app.ico = Basis (Fenster), app_on/off = Tray-Status gruen/rot. -->
    <EmbeddedResource Include="assets\app.ico">
      <LogicalName>app.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\app_on.ico">
      <LogicalName>app_on.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="assets\app_off.ico">
      <LogicalName>app_off.ico</LogicalName>
    </EmbeddedResource>
    <!-- OBS-/Browser-Steuer-Dock, vom HTTP-Agent unter / und /dock ausgeliefert. -->
    <EmbeddedResource Include="web\dock.html">
      <LogicalName>dock.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
