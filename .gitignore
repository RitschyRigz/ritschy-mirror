# Build output
bin/
obj/
publish/
*.user

# Release artifacts (installer is attached to GitHub Releases, not committed)
installer/out/

# Runtime / user state (created next to the exe at runtime)
mirror.log
app_settings.json

# Local dev captures / generated previews (the .ico files ARE tracked)
smoketest*.png
assets/*.png

# Documentation images are tracked (docs/icon.png, docs/screenshot-*.png)
